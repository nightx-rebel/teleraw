BOT_TOKEN=123456:ABC-your-bot-token
# First ID is the owner (gets channel posts, /history, /stats). Leave empty to allow everyone.
ALLOWED_IDS=123456789,987654321
# Any long random string. Needed once to open /api/setup?key=...
SETUP_KEY=change-me-to-a-long-random-string

# Added automatically if you connect Upstash from the Vercel Marketplace.
# Otherwise copy them from the Upstash console (REST API section).
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# Optional. Derived from BOT_TOKEN when not set.
# WEBHOOK_SECRET=
